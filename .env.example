# Copy this file to .env and fill in your own values.

# "development" (default) or "production"
APP_ENV=development
# Required in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=subway_system
DB_USER=root
DB_PASSWORD=your_mysql_password

# A hosting platform usually gives one URL instead of the five DB_* values:
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Demo data and accounts. In production the admin account is created only if ADMIN_PASSWORD is set.
# SEED_DEMO_DATA=1
# ADMIN_PASSWORD=choose-your-own
# DEMO_PASSWORD=demo123
